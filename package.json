  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node -e \"const fs=require('fs'); if(fs.existsSync('dist/index.html')){ fs.copyFileSync('dist/index.html', 'dist/200.html'); fs.copyFileSync('dist/index.html', 'dist/404.html'); console.log('✓ Cloudflare Pages & SPA fallbacks created: 200.html, 404.html'); }\"",
    "lint": "oxlint",
    "preview": "vite preview"
  },
